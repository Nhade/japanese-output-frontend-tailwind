# Database
SHIORI_DATABASE_PATH=
SHIORI_SESSION_SECRET=
SHIORI_SESSION_MAX_AGE_SECONDS=2592000
SHIORI_ALLOW_INSECURE_SESSION_SECRET=false

# Guest preview: 24-hour accounts minted from /preview on the frontend.
SHIORI_GUEST_PREVIEW_ENABLED=true
SHIORI_GUEST_DAILY_BUDGET=1500
SHIORI_GUEST_CREATES_PER_IP_PER_HOUR=10
SHIORI_GUEST_MAX_ACTIVE=300

# Production only: extra gunicorn flags read from the systemd EnvironmentFile.
# Threaded workers keep one slow LLM call from blocking the API; the timeout
# must exceed the daily-review agent's runtime. The deploy job fills this in
# when it is missing.
GUNICORN_CMD_ARGS="-k gthread --threads 4 --timeout 90 --graceful-timeout 30"

# Default LLM provider. Use ollama for local development.
LLM_PROVIDER=ollama
MODEL_NAME=gpt-oss:120b
API_BASE_URL=http://localhost:11434
API_KEY=ollama
AI_TIMEOUT=120

# Optional per-tier overrides. Leave blank to inherit the default provider.
QUALITY_PROVIDER=
QUALITY_MODEL=
QUALITY_API_BASE_URL=
QUALITY_API_KEY=
QUALITY_MAX_TOKENS=4096

BALANCED_PROVIDER=
BALANCED_MODEL=
BALANCED_API_BASE_URL=
BALANCED_API_KEY=
BALANCED_MAX_TOKENS=4096

FAST_PROVIDER=
FAST_MODEL=
FAST_API_BASE_URL=
FAST_API_KEY=
FAST_MAX_TOKENS=4096

# Optional safety classifier.
ENABLE_SAFETY_CHECK=true
GROQ_API_KEY=
GROQ_API_BASE_URL=

# Optional external services.
OPENAI_API_KEY=
# Translation prefers an API key (Cloud Translation API enabled in the same
# GCP project as the Gemini tier), then the service-account file, then the
# BALANCED LLM as a fallback.
GOOGLE_TRANSLATE_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=
